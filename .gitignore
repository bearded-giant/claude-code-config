# session data - ignore contents, keep structure
projects/*
!projects/.gitkeep
*.jsonl

# scratch - keep structure and WORKSPACE.md template
scratch/*/*
!scratch/*/.gitkeep
!scratch/WORKSPACE.md

todos/*
!todos/.gitkeep

shell-snapshots/*
!shell-snapshots/.gitkeep

statsig/*
!statsig/.gitkeep

# plugins - track config json, ignore runtime/downloaded content
plugins/cache/
plugins/marketplaces/
plugins/repos/
plugins/subtask/
plugins/install-counts-cache.json

# system files
.DS_Store
.claude/

# backup files
*.bak
settings.json.*.bak

# local settings (users should create their own)
settings.local.json

scratch
.giantmem/

plugins/blocklist.json
plugins/known_marketplaces.json

archive/*

# node deps
node_modules/

# python bytecode
__pycache__/
*.pyc

# transient memory state
.memory-project.json
.mdlive/

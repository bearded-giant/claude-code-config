[Unit]
Description=Discord multi-session daemon for Claude Code
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/dev/claude-code-config/discord-daemon
ExecStart=%h/.bun/bin/bun run src/server.ts
Restart=always
RestartSec=5
EnvironmentFile=%h/.claude/channels/discord/.env
Environment=NODE_ENV=production
NoNewPrivileges=yes

[Install]
WantedBy=default.target

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Bash",
      "Bash(bash -lc:*)",
      "Task",
      "TodoWrite",
      "Bash(scp:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(chmod)",
      "WebFetch(domain:alexop.dev)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:docs.claude-mem.ai)",
      "WebFetch(domain:github.com)",
      "mcp__plugin_kai_ai-tools-directory",
      "mcp__plugin_kai_atlassian",
      "mcp__plugin_kai_dba-mcp-prod",
      "mcp__plugin_kai_dba-mcp-stage",
      "mcp__plugin_kai_google-sheets",
      "mcp__plugin_kai_watchtower",
      "mcp__gong",
      "mcp__zendesk",
      "Skill(babysit)",
      "Skill(kai:*)",
      "Skill(kai-review:*)"
    ],
    "ask": [
      "Bash(git:push)"
    ],
    "defaultMode": "default",
    "additionalDirectories": [
      "/Users/bryan/"
    ]
  },
  "model": "Opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memory_session_start.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/workspace_session_hook.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/ensure_personal_claude.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/session_prime.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/discord_bun_orphan_sweep.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/discord_patch_apply.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/bryan/.nvm/versions/node/v24.11.1/bin/node\" \"/Users/bryan/.claude/hooks/caveman-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading caveman mode..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memory_curate.py"
          },
          {
            "type": "command",
            "command": "date +%s > /tmp/claude-compact-ts"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/precompact_capture.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memory_curate.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/workspace_session_end.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/session_end_ingest.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/discord_bun_reaper.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/debug_stop_check.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/notify_attention.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/guard_protected_paths.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/live_index.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/caveman_artifact_nudge.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memory_inject.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/bryan/.nvm/versions/node/v24.11.1/bin/node\" \"/Users/bryan/.claude/hooks/caveman-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking caveman mode..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/clear_attention.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/hooks/statusline.js"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "subtask": true,
    "commit-commands@claude-code-plugins": true,
    "feature-dev@claude-code-plugins": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "discord@claude-plugins-official": true,
    "caveman@caveman": true,
    "kai-review@kai": true,
    "kai@kai": true,
    "slack@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "kai": {
      "source": {
        "source": "directory",
        "path": "/Users/bryan/dev/ai/kai"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "channelsEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "verbose": true,
  "preferredNotifChannel": "terminal_bell",
  "feedbackSurveyState": {
    "lastShownTime": 1754071973699
  },
  "ENABLE_LSP_TOOL": "1",
  "mcpServers": {
    "giantmem-search": {
      "command": "/Users/bryan/.local/bin/giantmem",
      "args": [
        "mcp",
        "serve"
      ]
    },
    "doit": {
      "command": "/Users/bryan/.nvm/versions/node/v24.11.1/bin/node",
      "args": [
        "/Users/bryan/dev/lua/do-it.nvim/mcp/server.js"
      ]
    },
    "snowflake": {
      "type": "http",
      "url": "https://forge-mcp.infra.rechargeapps.com/mcp"
    }
  }
}
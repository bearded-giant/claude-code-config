{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Bash",
      "Bash(bash -lc:*)",
      "Task",
      "TodoWrite",
      "Bash(scp:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(chmod)",
      "Bash(black:*)",
      "Bash(ruff:*)",
      "Bash(isort:*)",
      "Bash(pylint:*)",
      "Bash(flake8:*)",
      "Bash(mypy:*)",
      "Bash(pyright:*)",
      "Bash(basedpyright:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "Bash(tsc:*)",
      "Bash(biome:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)",
      "Bash(npx biome:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo check:*)",
      "Bash(rustfmt:*)",
      "Skill(py-check)",
      "Skill(ts-check)",
      "WebFetch(domain:alexop.dev)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:github.com)",
      "mcp__plugin_kai_ai-tools-directory",
      "mcp__plugin_kai_atlassian",
      "mcp__plugin_kai_dba-mcp-prod",
      "mcp__plugin_kai_dba-mcp-stage",
      "mcp__plugin_kai_google-sheets",
      "mcp__plugin_kai_watchtower",
      "mcp__gong",
      "mcp__zendesk",
      "mcp__doit",
      "Skill(babysit)",
      "Skill(kai:*)",
      "Skill(kai-review:*)",
      "Bash(cd *)",
      "Bash(git *)",
      "Bash(pnpm *)",
      "Bash(tsc --build*)",
      "Bash(NODE_OPTIONS=--max_old_space_size=8192 npx eslint*)",
      "Bash(ls *)",
      "Bash(npx shopify app function build*)",
      "Bash(find *)",
      "Bash(rm:*)",
      "Bash(curl:*)",
      "Bash(gh *)"
    ],
    "ask": [],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": ["/Users/bryan/"]
  },
  "model": "Opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/giantmem daemon start >/dev/null 2>&1 || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/dispatch.py sync_settings workspace_session_hook ensure_personal_claude session_prime doit_session_prime memory_index_sweep",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import json,sys,time; d=json.load(sys.stdin); sid=d.get(\"session_id\") or \"global\"; open(\"/tmp/claude-compact-ts-\"+sid, \"w\").write(str(int(time.time())))'",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/precompact_capture.py",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/dispatch.py workspace_session_end session_end_ingest",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/debug_stop_check.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/notify_attention.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/guard_protected_paths.py",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/live_index.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/caveman_artifact_nudge.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/code_comment_nudge.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/dispatch.py standing_constraints giantmem_recall clear_attention",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/hooks/statusline.js"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "commit-commands@claude-code-plugins": false,
    "feature-dev@claude-code-plugins": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "discord@claude-plugins-official": false,
    "caveman@caveman": true,
    "kai-review@kai": true,
    "kai@kai": true,
    "slack@claude-plugins-official": true,
    "bigquery@skio": false,
    "debug-features@skio": false,
    "dev-workflow@skio": false,
    "fargate-jobs@skio": false,
    "hasura-schema@skio": false,
    "linear-triage@skio": false,
    "opensearch-logs@skio": false,
    "subscriptions@skio": false,
    "clangd-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "kai": {
      "source": {
        "source": "directory",
        "path": "/Users/bryan/dev/ai/kai"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "channelsEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "verbose": true,
  "preferredNotifChannel": "terminal_bell",
  "feedbackSurveyState": {
    "lastShownTime": 1754071973699
  },
  "ENABLE_LSP_TOOL": "1",
  "mcpServers": {
    "giantmem-search": {
      "command": "/Users/bryan/.local/bin/giantmem",
      "args": ["mcp", "serve"]
    },
    "doit": {
      "command": "/Users/bryan/.nvm/versions/node/v24.11.1/bin/node",
      "args": ["/Users/bryan/dev/lua/do-it.nvim/mcp/server.js"]
    },
    "snowflake": {
      "type": "http",
      "url": "https://forge-mcp.infra.rechargeapps.com/mcp"
    }
  }
}

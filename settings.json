{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Bash",
      "Bash(bash -lc:*)",
      "Task",
      "TodoWrite",
      "Bash(scp:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(chmod)",
      "WebFetch(domain:alexop.dev)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:docs.claude-mem.ai)",
      "WebFetch(domain:github.com)"
    ],
    "ask": [
      "Bash(git:push)"
    ],
    "defaultMode": "default",
    "additionalDirectories": [
      "/Users/bryan/"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memory_session_start.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/workspace_session_hook.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/ensure_personal_claude.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memory_curate.py"
          },
          {
            "type": "command",
            "command": "date +%s > /tmp/claude-compact-ts"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memory_curate.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/workspace_session_end.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/debug_stop_check.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/guard_protected_paths.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memory_inject.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/hooks/statusline.js"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "subtask": true,
    "commit-commands@claude-code-plugins": true,
    "feature-dev@claude-code-plugins": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "discord@claude-plugins-official": true
  },
  "spinnerTipsEnabled": false,
  "channelsEnabled": true,
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754071973699
  },
  "ENABLE_LSP_TOOL": "1",
  "mcpServers": {
    "salesforce-dx": {
      "command": "npx",
      "args": [
        "-y",
        "@salesforce/mcp",
        "--orgs",
        "DEFAULT_TARGET_ORG",
        "--toolsets",
        "orgs,metadata,data,users",
        "--tools",
        "run_apex_test",
        "--allow-non-ga-tools"
      ]
    },
    "giantmem-search": {
      "command": "python3",
      "args": [
        "/Users/bryan/dev/giant-tooling/giantmem-archive/mcp-search-server.py"
      ]
    }
  }
}

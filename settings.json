{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Bash",
      "Bash(bash -lc:*)",
      "Task",
      "TodoWrite",
      "Bash(scp:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(chmod)",
      "WebFetch(domain:alexop.dev)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:docs.claude-mem.ai)",
      "WebFetch(domain:github.com)"
    ],
    "ask": [
      "Bash(git:push)"
    ],
    "defaultMode": "default",
    "additionalDirectories": [
      "/Users/bryan/dev/script-hodge-podge/"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memory_session_start.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memory_curate.py"
          },
          {
            "type": "command",
            "command": "date +%s > /tmp/claude-compact-ts"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memory_curate.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memory_inject.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/hooks/statusline.js"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "subtask": true,
    "commit-commands@claude-code-plugins": true,
    "feature-dev@claude-code-plugins": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754071973699
  }
}

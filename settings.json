{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Bash",
      "Bash(bash -lc:*)",
      "Task",
      "TodoWrite",
      "Bash(scp:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(chmod)",
      "Bash(black:*)",
      "Bash(ruff:*)",
      "Bash(isort:*)",
      "Bash(pylint:*)",
      "Bash(flake8:*)",
      "Bash(mypy:*)",
      "Bash(pyright:*)",
      "Bash(basedpyright:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "Bash(tsc:*)",
      "Bash(biome:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)",
      "Bash(npx biome:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm type-check:*)",
      "Bash(pnpm format:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo check:*)",
      "Bash(rustfmt:*)",
      "Skill(py-check)",
      "Skill(ts-check)",
      "WebFetch(domain:alexop.dev)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:github.com)",
      "mcp__plugin_kai_ai-tools-directory",
      "mcp__plugin_kai_atlassian",
      "mcp__plugin_kai_dba-mcp-prod",
      "mcp__plugin_kai_dba-mcp-stage",
      "mcp__plugin_kai_google-sheets",
      "mcp__plugin_kai_watchtower",
      "mcp__gong",
      "mcp__zendesk",
      "mcp__doit",
      "Skill(babysit)",
      "Skill(kai:*)",
      "Skill(kai-review:*)",
      "Bash(cd *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(pnpm lint-changes*)",
      "Bash(pnpm build*)",
      "Bash(pnpm test:unit*)",
      "Bash(pnpm generate-no-watch*)",
      "Bash(pnpm --dir apps/cli run skio generateTranslations*)",
      "Bash(pnpm --filter @frost/cli build*)",
      "Bash(pnpm --filter @frost/cli analyze*)",
      "Bash(pnpm --filter cli build*)",
      "Bash(pnpm --filter cli analyze*)",
      "Bash(tsc --build*)",
      "Bash(NODE_OPTIONS=--max_old_space_size=8192 npx eslint*)",
      "Bash(ls *)",
      "Bash(npx shopify app function build*)",
      "Bash(find *)",
      "Bash(rm:*)",
      "Bash(curl:*)"
    ],
    "ask": [
      "Bash(git:push)"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/Users/bryan/"
    ]
  },
  "model": "Opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/giantmem daemon start >/dev/null 2>&1 || true"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/sync_settings.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/workspace_session_hook.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/ensure_personal_claude.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/session_prime.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/doit_session_prime.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memory_index_sweep.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/discord_bun_orphan_sweep.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/discord_patch_apply.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/bryan/.nvm/versions/node/v24.11.1/bin/node\" \"/Users/bryan/.claude/hooks/caveman-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading caveman mode..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "date +%s > /tmp/claude-compact-ts"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/precompact_capture.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/workspace_session_end.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/session_end_ingest.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/discord_bun_reaper.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/debug_stop_check.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/notify_attention.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/guard_protected_paths.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/live_index.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/caveman_artifact_nudge.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/standing_constraints.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/giantmem_recall.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/bryan/.nvm/versions/node/v24.11.1/bin/node\" \"/Users/bryan/.claude/hooks/caveman-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking caveman mode..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/clear_attention.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/hooks/statusline.js"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "subtask": true,
    "commit-commands@claude-code-plugins": true,
    "feature-dev@claude-code-plugins": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "discord@claude-plugins-official": true,
    "caveman@caveman": true,
    "kai-review@kai": true,
    "kai@kai": true,
    "slack@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "kai": {
      "source": {
        "source": "directory",
        "path": "/Users/bryan/dev/ai/kai"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "channelsEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "verbose": true,
  "preferredNotifChannel": "terminal_bell",
  "feedbackSurveyState": {
    "lastShownTime": 1754071973699
  },
  "ENABLE_LSP_TOOL": "1",
  "mcpServers": {
    "giantmem-search": {
      "command": "/Users/bryan/.local/bin/giantmem",
      "args": [
        "mcp",
        "serve"
      ]
    },
    "doit": {
      "command": "/Users/bryan/.nvm/versions/node/v24.11.1/bin/node",
      "args": [
        "/Users/bryan/dev/lua/do-it.nvim/mcp/server.js"
      ]
    },
    "snowflake": {
      "type": "http",
      "url": "https://forge-mcp.infra.rechargeapps.com/mcp"
    }
  }
}

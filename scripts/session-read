#!/usr/bin/env python3
# session-read - extract clean conversation text from a claude JSONL session
# usage: session-read <jsonl-path> [query] [--context N]

import argparse
import json
import re
import sys
import textwrap


def parse_args():
    p = argparse.ArgumentParser(description="read clean conversation from a claude JSONL session")
    p.add_argument("--file", "-f", required=True, help="path to .jsonl session file")
    p.add_argument("--query", "-q", nargs="*", help="search terms to filter and highlight")
    p.add_argument("--context", "-C", type=int, default=2, help="number of surrounding messages to show around matches (default 2)")
    p.add_argument("--no-filter", action="store_true", help="dump entire conversation (ignore query filtering)")
    p.add_argument("--exact", action="store_true", help="treat query as exact phrase (default: all keywords must appear)")
    return p.parse_args()


def extract_messages(jsonl_path):
    """pull ordered human/assistant text messages from session"""
    messages = []
    try:
        with open(jsonl_path, "r") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                except json.JSONDecodeError:
                    continue

                msg_type = msg.get("type")
                if msg_type not in ("human", "assistant"):
                    continue

                content = msg.get("message", {}).get("content", [])
                texts = []
                if isinstance(content, str):
                    texts.append(content)
                elif isinstance(content, list):
                    for block in content:
                        if isinstance(block, dict) and block.get("type") == "text":
                            texts.append(block["text"])
                        elif isinstance(block, str):
                            texts.append(block)

                if texts:
                    role = "YOU" if msg_type == "human" else "CLAUDE"
                    combined = "\n".join(texts)
                    # skip system-reminder-only messages
                    stripped = re.sub(r"<system-reminder>.*?</system-reminder>", "", combined, flags=re.DOTALL).strip()
                    if stripped:
                        messages.append((role, stripped))
    except Exception as e:
        print(f"error reading {jsonl_path}: {e}", file=sys.stderr)
        sys.exit(1)
    return messages


def wrap_text(text, width=100):
    """wrap long lines but preserve code blocks and short lines"""
    lines = text.split("\n")
    out = []
    in_code = False
    for line in lines:
        if line.strip().startswith("```"):
            in_code = not in_code
            out.append(line)
        elif in_code:
            out.append(line)
        elif len(line) > width:
            out.extend(textwrap.wrap(line, width=width, break_long_words=False, break_on_hyphens=False))
        else:
            out.append(line)
    return "\n".join(out)


def main():
    args = parse_args()
    messages = extract_messages(args.file)

    if not messages:
        print("no conversation content found")
        return

    query_display = " ".join(args.query) if args.query else None

    if query_display and not args.no_filter:
        if args.exact:
            patterns = [re.compile(re.escape(query_display), re.IGNORECASE)]
        else:
            patterns = [re.compile(re.escape(term), re.IGNORECASE) for term in args.query]

        match_indices = set()
        for i, (role, text) in enumerate(messages):
            if all(p.search(text) for p in patterns):
                match_indices.add(i)

        if not match_indices:
            print(f'no matches for "{query_display}" in {len(messages)} messages')
            return

        # expand to include context
        visible = set()
        for i in match_indices:
            for j in range(max(0, i - args.context), min(len(messages), i + args.context + 1)):
                visible.add(j)

        print(f'{len(match_indices)} matches in {len(messages)} messages\n')

        last_printed = -1
        for i in sorted(visible):
            if last_printed >= 0 and i > last_printed + 1:
                print("  ---\n")
            role, text = messages[i]
            marker = " <<" if i in match_indices else ""
            print(f"[{role}]{marker}")
            print(wrap_text(text))
            print()
            last_printed = i
    else:
        if query:
            print(f"showing all {len(messages)} messages (--no-filter)\n")
        for role, text in messages:
            print(f"[{role}]")
            print(wrap_text(text))
            print()


if __name__ == "__main__":
    main()

#!/bin/bash
# peer-probe - capture peer repo metadata in one shot for /peer-scout.
# outputs key=value lines (one per). handles features.json as list-of-dicts
# or dict-keyed-by-name. tolerates missing files. zero python dependency.
#
# usage: peer-probe <abs-path-to-peer-repo>

set -euo pipefail

peer="${1:-}"
if [ -z "$peer" ]; then
  echo "usage: peer-probe <abs-path-to-peer-repo>" >&2
  exit 2
fi

if [ ! -d "$peer" ]; then
  echo "error=not_a_directory"
  exit 1
fi

git_root=$(git -C "$peer" rev-parse --show-toplevel 2>/dev/null || true)
if [ -z "$git_root" ]; then
  echo "error=not_a_git_repo"
  exit 1
fi

short_name=$(basename "$git_root")
branch=$(git -C "$git_root" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "-")
dirty_count=$(git -C "$git_root" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
if [ "$dirty_count" = "0" ]; then
  dirty="no"
else
  dirty="yes"
fi

layout=$(cd "$git_root" && ls -1 2>/dev/null | tr '\n' ' ' | sed 's/ $//')

if [ -f "$git_root/CLAUDE.md" ]; then
  has_claude_md="yes"
else
  has_claude_md="no"
fi

active_feature="-"
features_json="$git_root/.giantmem/features/features.json"
if [ -f "$features_json" ]; then
  # try list shape first: .features[] | select(.status=="in_progress") | .name
  # fall back to dict shape: .features | to_entries[] | select(.value.status=="in_progress") | .key
  # fall back to top-level dict shape: to_entries[] | select(.value.status=="in_progress") | .key
  if command -v jq >/dev/null 2>&1; then
    active_feature=$(jq -r '
      if (.features | type) == "array" then
        .features[] | select(.status=="in_progress") | .name
      elif (.features | type) == "object" then
        .features | to_entries[] | select(.value.status=="in_progress") | .key
      elif type == "object" then
        to_entries[] | select(.value.status=="in_progress") | .key
      else empty end
    ' "$features_json" 2>/dev/null | head -n1)
    [ -z "$active_feature" ] && active_feature="-"
  else
    active_feature="?jq_missing"
  fi
fi

echo "git_root=$git_root"
echo "short_name=$short_name"
echo "branch=$branch"
echo "dirty=$dirty"
echo "layout=$layout"
echo "has_claude_md=$has_claude_md"
echo "active_feature=$active_feature"

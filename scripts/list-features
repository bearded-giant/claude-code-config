#!/bin/bash
# list-features - show feature status table from scratch/features/
# usage: list-features [path/to/scratch/features]

set -euo pipefail

features_dir="${1:-scratch/features}"

if [ ! -d "$features_dir" ]; then
  echo "no features directory at: $features_dir" >&2
  exit 1
fi

# collect feature data: date, status, name
data=""
for dir in "$features_dir"/*/; do
  [ -d "$dir" ] || continue
  name=$(basename "$dir")
  [ "$name" = "_index.md" ] && continue

  spec="$dir/spec.md"
  if [ -f "$spec" ]; then
    status=$(grep -m1 '^status:' "$spec" | awk '{print $2}' || echo "unknown")
    modified=$(stat -f '%Sm' -t '%Y-%m-%d' "$spec" 2>/dev/null || stat -c '%Y' "$spec" 2>/dev/null | head -c10 || echo "unknown")
  else
    status="unknown"
    modified="n/a"
  fi

  data+="${modified}\t${status}\t${name}\n"
done

if [ -z "$data" ]; then
  echo "no features found in $features_dir"
  exit 0
fi

# sort by date descending, then render table
sorted=$(echo -e "$data" | sort -rn)

# calculate column widths
max_name=7 max_status=6
while IFS=$'\t' read -r _ status name; do
  (( ${#name} > max_name )) && max_name=${#name}
  (( ${#status} > max_status )) && max_status=${#status}
done <<< "$sorted"

nw=$((max_name + 2))
sw=$((max_status + 2))
dw=15

# box drawing
h_line() {
  local c="$1" l="$2" m="$3" r="$4"
  printf "%s" "$c"
  printf '%*s' "$nw" '' | tr ' ' '-'
  printf "%s" "$m"
  printf '%*s' "$sw" '' | tr ' ' '-'
  printf "%s" "$m"
  printf '%*s' "$dw" '' | tr ' ' '-'
  printf "%s\n" "$r"
}

pad() { printf " %-*s" "$(($2 - 1))" "$1"; }

h_line '+' "$nw" '+' '+'
printf "|"; pad "Feature" "$nw"; printf "|"; pad "Status" "$sw"; printf "|"; pad "Last Modified" "$dw"; printf "|\n"
h_line '+' "$nw" '+' '+'

while IFS=$'\t' read -r date status name; do
  printf "|"; pad "$name" "$nw"; printf "|"; pad "$status" "$sw"; printf "|"; pad "$date" "$dw"; printf "|\n"
  h_line '+' "$nw" '+' '+'
done <<< "$sorted"

#!/bin/bash
# list-features - show feature status table from features.json cache
# auto-corrects spec.md status drift against features.json
# usage: list-features [path/to/scratch/features]

set -euo pipefail

features_dir="${1:-scratch/features}"
cache="$features_dir/features.json"

if [ ! -d "$features_dir" ]; then
  echo "no features directory at: $features_dir" >&2
  exit 1
fi

if [ ! -f "$cache" ]; then
  echo "no features.json cache at: $cache" >&2
  echo "run a feature command to initialize the cache" >&2
  exit 1
fi

# parse json, detect and fix drift between features.json and spec.md
drift_log=$(mktemp)
data=$(python3 -c "
import json, sys, os, re

with open('$cache') as f:
    features = json.load(f)
if not features:
    sys.exit(0)

fixes = []
for name, feat in features.items():
    cache_status = feat.get('status', 'unknown')
    spec_path = os.path.join('$features_dir', name, 'spec.md')
    if not os.path.isfile(spec_path):
        continue
    with open(spec_path) as sf:
        spec_text = sf.read()
    m = re.search(r'^status:\s*(\S+)', spec_text, re.MULTILINE)
    if m and m.group(1) != cache_status:
        fixed = re.sub(r'^(status:\s*)\S+', r'\g<1>' + cache_status, spec_text, count=1, flags=re.MULTILINE)
        with open(spec_path, 'w') as sf:
            sf.write(fixed)
        fixes.append(f'  {name}: {m.group(1)} -> {cache_status}')

if fixes:
    with open('$drift_log', 'w') as dl:
        dl.write('\n'.join(fixes))

rows = []
for name, feat in features.items():
    status = feat.get('status', 'unknown')
    branch = feat.get('branch', '') or '-'
    last = feat.get('last_session', feat.get('created', 'n/a'))
    rows.append((last, status, branch, name))
rows.sort(key=lambda r: r[0], reverse=True)
for r in rows:
    print('\t'.join(r))
")

if [ -z "$data" ]; then
  echo "no features found"
  rm -f "$drift_log"
  exit 0
fi

# show drift corrections before the table
if [ -s "$drift_log" ]; then
  echo "synced spec.md status drift:"
  cat "$drift_log"
  echo ""
fi
rm -f "$drift_log"

# calculate column widths
max_name=7 max_status=6 max_branch=6
while IFS=$'\t' read -r _ status branch name; do
  (( ${#name} > max_name )) && max_name=${#name}
  (( ${#status} > max_status )) && max_status=${#status}
  (( ${#branch} > max_branch )) && max_branch=${#branch}
done <<< "$data"

nw=$((max_name + 2))
sw=$((max_status + 2))
bw=$((max_branch + 2))
dw=15

h_line() {
  local c="$1" m="$2" r="$3"
  printf "%s" "$c"
  printf '%*s' "$nw" '' | tr ' ' '-'
  printf "%s" "$m"
  printf '%*s' "$sw" '' | tr ' ' '-'
  printf "%s" "$m"
  printf '%*s' "$bw" '' | tr ' ' '-'
  printf "%s" "$m"
  printf '%*s' "$dw" '' | tr ' ' '-'
  printf "%s\n" "$r"
}

pad() { printf " %-*s" "$(($2 - 1))" "$1"; }

h_line '+' '+' '+'
printf "|"; pad "Feature" "$nw"; printf "|"; pad "Status" "$sw"; printf "|"; pad "Branch" "$bw"; printf "|"; pad "Last Modified" "$dw"; printf "|\n"
h_line '+' '+' '+'

while IFS=$'\t' read -r date status branch name; do
  printf "|"; pad "$name" "$nw"; printf "|"; pad "$status" "$sw"; printf "|"; pad "$branch" "$bw"; printf "|"; pad "$date" "$dw"; printf "|\n"
  h_line '+' '+' '+'
done <<< "$data"
